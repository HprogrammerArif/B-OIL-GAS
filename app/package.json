{
  "name": "bogcl-oneops-mobile",
  "main": "expo-router/entry",
  "version": "0.1.0",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/noto-sans-bengali": "^0.4.4",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^5.9.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@reduxjs/toolkit": "^2.12.0",
    "@sentry/react-native": "~7.11.0",
    "@shopify/flash-list": "2.0.2",
    "date-fns": "^4.4.0",
    "expo": "~56.0.12",
    "expo-application": "~56.0.3",
    "expo-audio": "~56.0.13",
    "expo-build-properties": "~56.0.27",
    "expo-camera": "~56.0.8",
    "expo-constants": "~56.0.18",
    "expo-crypto": "~56.0.5",
    "expo-dev-client": "~56.0.28",
    "expo-device": "~56.0.4",
    "expo-file-system": "~56.0.11",
    "expo-font": "~56.0.7",
    "expo-haptics": "~56.0.3",
    "expo-image": "~56.0.12",
    "expo-image-manipulator": "~56.0.26",
    "expo-image-picker": "~56.0.25",
    "expo-linking": "~56.0.17",
    "expo-local-authentication": "~56.0.5",
    "expo-localization": "~56.0.6",
    "expo-location": "~56.0.26",
    "expo-notifications": "~56.0.25",
    "expo-router": "~56.2.20",
    "expo-screen-capture": "~56.0.5",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.27",
    "expo-splash-screen": "~56.0.10",
    "expo-status-bar": "~56.0.4",
    "expo-system-ui": "~56.0.5",
    "expo-web-browser": "~56.0.6",
    "i18next": "^26.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.87.0",
    "react-i18next": "^17.1.10",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-toast-message": "^2.3.3",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.3.0",
    "redux-persist": "^6.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/expo__vector-icons": "^9.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~56.0.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~56.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "3.10.1",
    "husky": "^9.1.7",
    "jest": "~29.7.0",
    "jest-expo": "^56.0.5",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "doctor": "npx expo-doctor",
    "fix": "npx expo install --fix",
    "clean": "npx expo start -c",
    "rebuild": "npx expo prebuild --clean",
    "build:android": "eas build -p android --profile preview",
    "build:android:prod": "eas build -p android --profile production",
    "build:ios": "eas build -p ios --profile preview",
    "build:ios:prod": "eas build -p ios --profile production",
    "update": "eas update --branch production",
    "prepare": "husky"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest.cssMock.js"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|immer))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md}": [
      "prettier --write"
    ]
  }
}
