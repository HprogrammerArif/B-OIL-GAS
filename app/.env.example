# Copy to .env.local and fill in. Never commit .env.local. This file lists variable NAMES only.

# "mock" runs the in-app mock server (src/mock); "live" talks to server/ at EXPO_PUBLIC_API_URL.
EXPO_PUBLIC_API_MODE=mock

# Required only when EXPO_PUBLIC_API_MODE=live (no trailing slash).
EXPO_PUBLIC_API_URL=

# Sentry (optional). Leave EXPO_PUBLIC_SENTRY_DSN blank to disable.
EXPO_PUBLIC_SENTRY_DSN=

# Build-time only (source-map upload). Set in your shell or EAS secrets; never use the EXPO_PUBLIC_ prefix.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Expo / EAS identity (used by app.config.ts and push registration).
EXPO_OWNER=
EXPO_PUBLIC_PROJECT_ID=
